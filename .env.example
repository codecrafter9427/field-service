# Field Service — environment placeholders only (copy to .env; never commit secrets)

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=field_service
POSTGRES_USER=field_service
POSTGRES_PASSWORD=change_me_local_only

# Backend
DATABASE_URL=postgresql+psycopg://field_service:change_me_local_only@localhost:5432/field_service
API_HOST=0.0.0.0
API_PORT=8003
CORS_ORIGINS=http://localhost:3003
DEMO_AUTH_ENABLED=true
SECRET_KEY=replace_with_local_demo_secret

# AI (local Ollama optional; DemoAIProvider always available)
AI_PROVIDER=demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8003/api/v1
NEXT_PUBLIC_APP_NAME=Field Service
